pipeline {

    agent any

    environment {

        // ==============================
        // Docker Hub
        // ==============================
        BACKEND_IMAGE  = 'yuvarajm1810/realtime-backend-v1'
        FRONTEND_IMAGE = 'yuvarajm1810/realtime-frontend-v1'

        // ==============================
        // GitHub
        // ==============================
        GIT_REPO = 'https://github.com/yuvarajm-devops/devops-full-practice.git'

        // ==============================
        // EC2
        // ==============================
        EC2_USER = 'ubuntu'
        EC2_HOST = '3.110.173.66'

        // NEW deployment folder
        EC2_APP_DIR = '/home/ubuntu/realtime-3tier-app-new'
    }

    stages {

        // ==================================================
        // 1. CHECKOUT
        // ==================================================

        stage('Checkout') {
            steps {

                echo '======================================'
                echo 'CHECKOUT FROM GITHUB'
                echo '======================================'

                git(
                    branch: 'main',
                    credentialsId: 'github-credentials',
                    url: "${GIT_REPO}"
                )
            }
        }


        // ==================================================
        // 2. BUILD BACKEND
        // ==================================================

        stage('Build Backend Image') {
            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "BUILDING BACKEND IMAGE"
                    echo "======================================"

                    docker build 
                        -t ${BACKEND_IMAGE}:${BUILD_NUMBER} 
                        -t ${BACKEND_IMAGE}:latest 
                        ./backend

                    echo "Backend image build completed."
                '''
            }
        }


        // ==================================================
        // 3. BUILD FRONTEND
        // ==================================================

        stage('Build Frontend Image') {
            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "BUILDING FRONTEND IMAGE"
                    echo "======================================"

                    docker build \
                        -t ${FRONTEND_IMAGE}:${BUILD_NUMBER} \
                        -t ${FRONTEND_IMAGE}:latest \
                        ./frontend

                    echo "Frontend image build completed."
                '''
            }
        }


        // ==================================================
        // 4. PUSH TO DOCKER HUB
        // ==================================================

        stage('Push Images to Docker Hub') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "LOGIN TO DOCKER HUB"
                        echo "======================================"

                        echo "$DOCKER_PASSWORD" | docker login \
                            --username "$DOCKER_USERNAME" \
                            --password-stdin


                        echo "======================================"
                        echo "PUSHING BACKEND"
                        echo "======================================"

                        docker push ${BACKEND_IMAGE}:${BUILD_NUMBER}
                        docker push ${BACKEND_IMAGE}:latest


                        echo "======================================"
                        echo "PUSHING FRONTEND"
                        echo "======================================"

                        docker push ${FRONTEND_IMAGE}:${BUILD_NUMBER}
                        docker push ${FRONTEND_IMAGE}:latest


                        echo "======================================"
                        echo "DOCKER HUB PUSH COMPLETED"
                        echo "======================================"

                        docker logout
                    '''
                }
            }
        }


        // ==================================================
        // 5. PREPARE EC2
        // ==================================================

        stage('Prepare EC2 Deployment Folder') {

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "PREPARING EC2"
                        echo "======================================"

                        chmod 600 "$SSH_KEY"

                        ssh \
                            -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_HOST" << EOF

                            set -e

                            echo "Creating application directory..."

                            mkdir -p "$EC2_APP_DIR"

                            echo "Checking .env..."

                            if [ ! -f "$EC2_APP_DIR/.env" ]; then
                                echo "ERROR: .env file is missing from $EC2_APP_DIR"
                                exit 1
                            fi

                            echo ".env exists."

                            echo "Checking Docker..."

                            docker --version

                            echo "Checking Docker Compose..."

                            docker compose version

EOF
                    '''
                }
            }
        }


        // ==================================================
        // 6. COPY COMPOSE FILE
        // ==================================================

        stage('Copy Docker Compose') {

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "COPYING DOCKER COMPOSE"
                        echo "======================================"

                        chmod 600 "$SSH_KEY"

                        scp \
                            -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            docker-compose.yml \
                            "$SSH_USER@$EC2_HOST:$EC2_APP_DIR/docker-compose.yml"

                        echo "docker-compose.yml copied."

                        echo ""
                        echo ".env is NOT copied."
                        echo ".env remains private on EC2."
                    '''
                }
            }
        }


        // ==================================================
        // 7. DEPLOY
        // ==================================================

        stage('Deploy Application') {

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "DEPLOYING APPLICATION"
                        echo "======================================"

                        chmod 600 "$SSH_KEY"

                        ssh \
                            -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_HOST" << EOF

                            set -e

                            cd "$EC2_APP_DIR"

                            echo "======================================"
                            echo "PULLING BACKEND IMAGE"
                            echo "======================================"

                            docker pull ${BACKEND_IMAGE}:latest


                            echo "======================================"
                            echo "PULLING FRONTEND IMAGE"
                            echo "======================================"

                            docker pull ${FRONTEND_IMAGE}:latest


                            echo "======================================"
                            echo "STARTING APPLICATION"
                            echo "======================================"

                            docker compose up -d --no-build


                            echo "======================================"
                            echo "APPLICATION STATUS"
                            echo "======================================"

                            docker compose ps


                            echo "======================================"
                            echo "RUNNING CONTAINERS"
                            echo "======================================"

                            docker ps

EOF
                    '''
                }
            }
        }


        // ==================================================
        // 8. VERIFY
        // ==================================================

        stage('Verify Containers') {

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "VERIFYING APPLICATION"
                        echo "======================================"

                        chmod 600 "$SSH_KEY"

                        ssh \
                            -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_HOST" << EOF

                            set -e

                            cd "$EC2_APP_DIR"

                            docker compose ps

                            echo ""
                            echo "Checking running containers..."

                            docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"

EOF
                    '''
                }
            }
        }


        // ==================================================
        // 9. CLEANUP JENKINS DOCKER
        // ==================================================

        stage('Cleanup Jenkins Docker Images') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "CLEANING UNUSED JENKINS IMAGES"
                    echo "======================================"

                    docker image prune -f

                    echo "Jenkins Docker cleanup completed."
                '''
            }
        }
    }


    // ==================================================
    // POST ACTIONS
    // ==================================================

    post {

        success {

            echo '''
========================================
DEPLOYMENT SUCCESSFUL
========================================

Backend and frontend images were built
and pushed to Docker Hub.

EC2 deployment completed successfully.
'''
        }

        failure {

            echo '''
========================================
DEPLOYMENT FAILED
========================================

Check the Jenkins Console Output.
'''
        }

        always {

            echo '''
========================================
JENKINS PIPELINE COMPLETED
========================================
'''
        }
    }
}




